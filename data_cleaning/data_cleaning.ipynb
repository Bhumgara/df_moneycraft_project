  {
   "cell_type": "markdown",
   "id": "70e8fe07",
   "metadata": {},
   "source": [
    "## Data Transformations\n",
    "A few of the data types could be better adjusted to suit the data stored. As such we'll now perform some transformations to better align our data with our needs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "404d32fb",
   "metadata": {},
   "outputs": [],
   "source": [
    "'''\n",
    "Account DataFrame columns before:\n",
    " 0   customer_id          non-null  int64 \n",
    " 1   month                non-null  object\n",
    " 2   acquisition_channel  non-null  object\n",
    " 3   region               non-null  object\n",
    " 4   age_band             non-null  object\n",
    " 5   account_tier         non-null  object\n",
    " 6   monthly_fee          non-null  int64 \n",
    " 7   joined_on_promo      non-null  bool  \n",
    "'''\n",
    "accounts_df['month'] = pd.to_datetime(accounts_df['month'], format='%Y-%m').dt.to_period('M') # https://pandas.pydata.org/docs/reference/api/pandas.Series.dt.to_period.html\n",
    "accounts_df['acquisition_channel'] = accounts_df['acquisition_channel'].astype('string')\n",
    "accounts_df['region'] = accounts_df['region'].astype('string')\n",
    "age_band_defined_order = ['18-24', '25-34', '35-44', '45-54', '55-64', '65+']\n",
    "accounts_df['age_band'] = pd.Categorical(accounts_df['age_band'], categories=age_band_defined_order, ordered=True) # https://pandas.pydata.org/docs/user_guide/categorical.html\n",
    "account_tier_defined_order = ['Classic', 'Silver', 'Gold', 'Platinum']\n",
    "accounts_df['account_tier'] = pd.Categorical(accounts_df['account_tier'], categories=account_tier_defined_order, ordered=True)\n",
    "accounts_df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b9376bd8",
   "metadata": {},
   "outputs": [],
   "source": [
    "'''\n",
    "Closure DataFrame columns before:\n",
    " 0   customer_id  non-null   int64 \n",
    " 1   close_month  non-null   object\n",
    " 2   reason_code  non-null   object\n",
    "'''\n",
    "closure_df['close_month'] = pd.to_datetime(closure_df['close_month'], format='%Y-%m').dt.to_period('M')\n",
    "closure_df['reason_code'] = closure_df['reason_code'].astype('string')\n",
    "closure_df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f43994a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "'''\n",
    "Marketing DataFrame columns before:\n",
    " 0   month      non-null    object \n",
    " 1   channel    non-null    object \n",
    " 2   spend_gbp  non-null    float64\n",
    "'''\n",
    "marketing_df['month'] = pd.to_datetime(marketing_df['month'], format='%Y-%m').dt.to_period('M')\n",
    "marketing_df['channel'] = marketing_df['channel'].astype('string')\n",
    "marketing_df.info()"
   ]
  },
  }
