   "metadata": {},
   "source": [
    "## Gathering Data Paths\n",
    "Data paths were stored in the .env file, and the data itself is excluded from the git repository to avoid any client data leaks."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7714d42d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "load_dotenv(dotenv_path=\"../.env\")\n",
    "\n",
    "accounts_raw_data_path = os.getenv(\"accounts_data_path\")\n",
    "closure_raw_data_path = os.getenv(\"closure_data_path\")\n",
    "marketing_raw_data_path = os.getenv(\"marketing_data_path\")\n",
    "\n",
    "# Convert it safely to an absolute path relative to the notebook's location\n",
    "NOTEBOOK_DIR = \"../\"\n",
    "ACC_DATA_PATH = NOTEBOOK_DIR + accounts_raw_data_path\n",
    "CLOSURE_DATA_PATH = NOTEBOOK_DIR + closure_raw_data_path\n",
    "MARKETING_DATA_PATH = NOTEBOOK_DIR + marketing_raw_data_path\n",
    "\n",
    "print(f\"Accounts data path: {ACC_DATA_PATH}\")\n",
    "print(f\"Closure data path: {CLOSURE_DATA_PATH}\")\n",
    "print(f\"Marketing data path: {MARKETING_DATA_PATH}\")"
   ]
  },
